<resources>
    <!-- Base application theme, monochrome with one accent. Colours flip in values-night/colors.xml -->
    <style name="Theme.FFShare" parent="Theme.MaterialComponents.DayNight">
        <item name="colorPrimary">@color/mono_primary</item>
        <item name="colorPrimaryVariant">@color/mono_primary</item>
        <item name="colorOnPrimary">@color/mono_on_primary</item>
        <item name="colorSecondary">@color/mono_accent</item>
        <item name="colorOnSecondary">@color/white</item>
        <item name="colorSurface">@color/mono_surface</item>
        <item name="colorOnSurface">@color/mono_text</item>
        <item name="android:colorBackground">@color/mono_background</item>

        <item name="android:textColor">@color/mono_text</item>
        <item name="android:textColorSecondary">@color/mono_text_secondary</item>

        <!-- flat bars that blend with the background -->
        <item name="actionBarStyle">@style/Widget.MaterialComponents.ActionBar.Surface</item>
        <item name="actionBarTheme">@style/ThemeOverlay.MaterialComponents.ActionBar.Surface</item>
        <item name="android:statusBarColor">@color/mono_background</item>
        <item name="android:windowLightStatusBar">@bool/light_status_bar</item>

        <!-- nothing look everywhere: pill buttons, flat rounded cards -->
        <item name="materialButtonStyle">@style/Widget.Nothing.Button</item>
        <item name="materialButtonOutlinedStyle">@style/Widget.Nothing.Button.Outlined</item>
        <item name="materialCardViewStyle">@style/Widget.Nothing.Card</item>
    </style>

    <style name="Button.Copy" parent="Theme.MaterialComponents.DayNight.DarkActionBar" >
        <item name="colorAccent">@color/light_grey</item>
    </style>


    <style name="Theme.FFShare.NoActionBar">
        <item name="windowActionBar">false</item>
        <item name="windowNoTitle">true</item>
    </style>

    <style name="Theme.FFShare.AppBarOverlay" parent="ThemeOverlay.MaterialComponents.Toolbar.Surface" />

    <style name="Theme.FFShare.PopupOverlay" parent="ThemeOverlay.AppCompat.DayNight" />

    <!-- nothing look: dot-matrix display type (Doto, OFL), monospace uppercase labels (Space Mono, OFL) -->
    <style name="TextAppearance.Nothing.Display" parent="TextAppearance.MaterialComponents.Headline4">
        <item name="fontFamily">@font/doto_black</item>
        <item name="android:fontFamily">@font/doto_black</item>
        <item name="android:textStyle">normal</item>
        <item name="android:textColor">@color/mono_text</item>
    </style>

    <!-- big numbers like "6.3 GB saved" -->
    <style name="TextAppearance.FFShare.BigNumber" parent="TextAppearance.Nothing.Display">
        <item name="android:textColor">@color/mono_accent</item>
    </style>

    <style name="TextAppearance.Nothing.Title" parent="TextAppearance.Widget.AppCompat.Toolbar.Title">
        <item name="fontFamily">@font/doto_black</item>
        <item name="android:fontFamily">@font/doto_black</item>
        <item name="android:textSize">24sp</item>
    </style>

    <style name="TextAppearance.Nothing.Label" parent="TextAppearance.MaterialComponents.Overline">
        <item name="fontFamily">@font/space_mono</item>
        <item name="android:fontFamily">@font/space_mono</item>
        <item name="android:textSize">12sp</item>
        <item name="android:letterSpacing">0.12</item>
        <item name="android:textAllCaps">true</item>
        <item name="android:textColor">@color/mono_text_secondary</item>
    </style>

    <!-- pill buttons with monospace caps, the main call to action -->
    <style name="Widget.Nothing.Button" parent="Widget.MaterialComponents.Button">
        <item name="fontFamily">@font/space_mono_bold</item>
        <item name="android:fontFamily">@font/space_mono_bold</item>
        <item name="android:letterSpacing">0.06</item>
        <item name="cornerRadius">32dp</item>
    </style>

    <style name="Widget.Nothing.Button.Outlined" parent="Widget.MaterialComponents.Button.OutlinedButton">
        <item name="fontFamily">@font/space_mono_bold</item>
        <item name="android:fontFamily">@font/space_mono_bold</item>
        <item name="android:letterSpacing">0.06</item>
        <item name="cornerRadius">18dp</item>
        <item name="strokeColor">@color/mono_text</item>
    </style>

    <style name="Widget.Nothing.Button.Text" parent="Widget.MaterialComponents.Button.TextButton">
        <item name="fontFamily">@font/space_mono_bold</item>
        <item name="android:fontFamily">@font/space_mono_bold</item>
        <item name="android:letterSpacing">0.06</item>
    </style>

    <!-- one option of a two-way choice (MaterialButtonToggleGroup) -->
    <style name="Widget.Nothing.Button.Toggle" parent="Widget.Nothing.Button.Outlined">
        <item name="backgroundTint">@color/toggle_background</item>
        <item name="android:textColor">@color/toggle_text</item>
        <item name="android:textAllCaps">false</item>
    </style>

    <!-- flat rounded panels instead of shadowed cards -->
    <style name="Widget.Nothing.Card" parent="Widget.MaterialComponents.CardView">
        <item name="cardElevation">0dp</item>
        <item name="cardCornerRadius">20dp</item>
        <item name="cardBackgroundColor">@color/mono_surface</item>
    </style>
</resources>
