<?xml version="1.0" encoding="utf-8"?>
<!-- one quality preset on the main screen, swiped through with ViewPager2 (pages must be match_parent) -->
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent">

    <com.google.android.material.card.MaterialCardView
        android:id="@+id/card"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:layout_marginVertical="4dp"
        app:strokeColor="@color/mono_primary">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:padding="16dp">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:gravity="center_vertical"
                android:orientation="horizontal">

                <TextView
                    android:id="@+id/txtPresetName"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:textAppearance="@style/TextAppearance.Nothing.Display"
                    android:textSize="28sp" />

                <TextView
                    android:id="@+id/txtPresetBadge"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="8dp"
                    android:background="@drawable/preset_badge"
                    android:paddingHorizontal="10dp"
                    android:paddingVertical="2dp"
                    android:textAppearance="@style/TextAppearance.Nothing.Label"
                    android:textColor="@color/mono_text"
                    android:textSize="10sp" />
            </LinearLayout>

            <TextView
                android:id="@+id/txtPresetTagline"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="4dp"
                android:textSize="15sp" />

            <TextView
                android:id="@+id/txtPresetSpec"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="2dp"
                android:alpha="0.7"
                android:textSize="13sp" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="12dp"
                android:text="@string/preset_example_title"
                android:textAppearance="@style/TextAppearance.Nothing.Label"
                android:textSize="10sp" />

            <TextView
                android:id="@+id/txtPresetExample"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="2dp"
                android:lineSpacingExtra="2dp"
                android:textSize="14sp" />

            <Button
                android:id="@+id/btnPresetSettings"
                style="@style/Widget.Nothing.Button.Text"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginStart="-8dp"
                android:text="@string/preset_open_settings" />
        </LinearLayout>
    </com.google.android.material.card.MaterialCardView>
</FrameLayout>
