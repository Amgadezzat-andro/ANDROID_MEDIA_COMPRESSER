<?xml version="1.0" encoding="utf-8"?>
<!-- progress while compressing, then the results page in the same screen -->
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent">

    <!-- ================= progress ================= -->
    <ScrollView
        android:id="@+id/progressContainer"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:fillViewport="true">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:gravity="center_horizontal"
            android:orientation="vertical"
            android:padding="24dp">

            <TextView
                android:id="@+id/txtCommandNumber"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="32dp"
                android:text="@string/progress_starting"
                android:textAppearance="@style/TextAppearance.Nothing.Display"
                android:textSize="32sp" />

            <com.google.android.material.progressindicator.LinearProgressIndicator
                android:id="@+id/progressBar"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="16dp"
                android:indeterminate="true"
                android:max="1000"
                app:indicatorColor="?attr/colorSecondary"
                app:trackCornerRadius="4dp"
                app:trackThickness="8dp" />

            <TextView
                android:id="@+id/txtEta"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="8dp"
                android:textColor="?android:attr/textColorSecondary"
                android:textSize="16sp" />

            <!-- live "saved so far" line, filled in by MediaCompressor -->
            <TextView
                android:id="@+id/txtSavings"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="16dp"
                android:textAlignment="center"
                android:textColor="?attr/colorSecondary"
                android:textSize="18sp"
                android:textStyle="bold" />

            <com.google.android.material.card.MaterialCardView
                android:layout_width="200dp"
                android:layout_height="200dp"
                android:layout_marginTop="24dp">

                <ImageView
                    android:id="@+id/imgThumbnail"
                    android:layout_width="match_parent"
                    android:layout_height="match_parent"
                    android:contentDescription="@string/progress_thumbnail"
                    android:scaleType="centerCrop" />
            </com.google.android.material.card.MaterialCardView>

            <!-- no "run in background" button: leaving this screen any way keeps the batch going -->
            <TextView
                android:id="@+id/lblBackgroundHint"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="20dp"
                android:alpha="0.7"
                android:gravity="center"
                android:text="@string/progress_background_hint"
                android:textSize="14sp" />

            <Button
                android:id="@+id/btnCancel"
                style="@style/Widget.Nothing.Button.Outlined"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="12dp"
                android:text="@string/cancel_ffmpeg" />

            <TextView
                android:id="@+id/lblDetailsToggle"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="24dp"
                android:background="?attr/selectableItemBackground"
                android:padding="8dp"
                android:text="@string/progress_details_show"
                android:textAppearance="@style/TextAppearance.Nothing.Label" />

            <!-- technical details, hidden unless asked for: the running command and the file in and out -->
            <com.google.android.material.card.MaterialCardView
                android:id="@+id/detailsContainer"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="8dp"
                android:visibility="gone">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:padding="20dp">

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="@string/details_command"
                        android:textAppearance="@style/TextAppearance.Nothing.Label" />

                    <TextView
                        android:id="@+id/txtFfmpegCommand"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="6dp"
                        android:background="@drawable/details_code_background"
                        android:fontFamily="@font/space_mono"
                        android:lineSpacingExtra="2dp"
                        android:padding="12dp"
                        android:textIsSelectable="true"
                        android:textSize="12sp" />

                    <!-- label, name, size: one line each -->
                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="16dp"
                        android:baselineAligned="true"
                        android:orientation="horizontal">

                        <TextView
                            android:layout_width="88dp"
                            android:layout_height="wrap_content"
                            android:text="@string/details_input"
                            android:textAppearance="@style/TextAppearance.Nothing.Label" />

                        <TextView
                            android:id="@+id/txtInputFile"
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_weight="1"
                            android:ellipsize="middle"
                            android:singleLine="true"
                            android:textSize="15sp" />

                        <TextView
                            android:id="@+id/txtInputFileSize"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_marginStart="8dp"
                            android:fontFamily="@font/space_mono"
                            android:textSize="13sp" />
                    </LinearLayout>

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="10dp"
                        android:baselineAligned="true"
                        android:orientation="horizontal">

                        <TextView
                            android:layout_width="88dp"
                            android:layout_height="wrap_content"
                            android:text="@string/details_output"
                            android:textAppearance="@style/TextAppearance.Nothing.Label" />

                        <TextView
                            android:id="@+id/txtOutputFile"
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_weight="1"
                            android:ellipsize="middle"
                            android:singleLine="true"
                            android:textSize="15sp" />

                        <TextView
                            android:id="@+id/txtOutputFileSize"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_marginStart="8dp"
                            android:fontFamily="@font/space_mono"
                            android:textColor="@color/mono_accent"
                            android:textSize="13sp" />
                    </LinearLayout>

                    <!-- videos only: how far into the clip ffmpeg is -->
                    <LinearLayout
                        android:id="@+id/processedTableRow"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="10dp"
                        android:baselineAligned="true"
                        android:orientation="horizontal">

                        <TextView
                            android:layout_width="88dp"
                            android:layout_height="wrap_content"
                            android:text="@string/details_progress"
                            android:textAppearance="@style/TextAppearance.Nothing.Label" />

                        <TextView
                            android:id="@+id/txtProcessedTime"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:fontFamily="@font/space_mono"
                            android:textSize="13sp" />

                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:fontFamily="@font/space_mono"
                            android:text=" / "
                            android:textSize="13sp"
                            tools:ignore="HardcodedText" />

                        <TextView
                            android:id="@+id/txtProcessedTimeTotal"
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_weight="1"
                            android:fontFamily="@font/space_mono"
                            android:textSize="13sp" />

                        <TextView
                            android:id="@+id/txtProcessedPercent"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_marginStart="8dp"
                            android:fontFamily="@font/space_mono"
                            android:textSize="13sp" />
                    </LinearLayout>
                </LinearLayout>
            </com.google.android.material.card.MaterialCardView>
        </LinearLayout>
    </ScrollView>

    <!-- ================= results ================= -->
    <ScrollView
        android:id="@+id/resultContainer"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:visibility="gone">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:padding="24dp">

            <TextView
                android:id="@+id/txtResultTitle"
                style="@style/TextAppearance.FFShare.BigNumber"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="32dp" />

            <TextView
                android:id="@+id/txtResultSummary"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="4dp"
                android:textSize="16sp" />

            <!-- before / after bars -->
            <TextView
                android:id="@+id/lblBefore"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="24dp"
                android:textColor="?android:attr/textColorSecondary" />

            <com.google.android.material.progressindicator.LinearProgressIndicator
                android:id="@+id/barBefore"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="4dp"
                android:max="1000"
                android:progress="1000"
                app:indicatorColor="?android:attr/textColorSecondary"
                app:trackCornerRadius="4dp"
                app:trackThickness="12dp" />

            <TextView
                android:id="@+id/lblAfter"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="12dp"
                android:textColor="?android:attr/textColorSecondary" />

            <com.google.android.material.progressindicator.LinearProgressIndicator
                android:id="@+id/barAfter"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="4dp"
                android:max="1000"
                app:indicatorColor="?attr/colorSecondary"
                app:trackCornerRadius="4dp"
                app:trackThickness="12dp" />

            <TextView
                android:id="@+id/txtResultNotes"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="16dp"
                android:textColor="?android:attr/textColorSecondary" />

            <Button
                android:id="@+id/btnShowFailed"
                style="@style/Widget.Nothing.Button.Text"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/result_see_failed"
                android:visibility="gone" />

            <TextView
                android:id="@+id/lblBiggestSavings"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="24dp"
                android:text="@string/result_biggest_savings"
                android:textAppearance="@style/TextAppearance.Nothing.Label" />

            <TextView
                android:id="@+id/txtBiggestSavings"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="8dp"
                android:lineSpacingExtra="6dp" />

            <TextView
                android:id="@+id/txtTrashInfo"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="32dp" />

            <Button
                android:id="@+id/btnTrash"
                android:layout_width="match_parent"
                android:layout_height="64dp"
                android:layout_marginTop="12dp"
                android:textSize="16sp"
                app:cornerRadius="12dp" />

            <Button
                android:id="@+id/btnUndoTrash"
                style="@style/Widget.Nothing.Button.Outlined"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="8dp"
                android:text="@string/result_undo"
                android:visibility="gone" />

            <Button
                android:id="@+id/btnOpenFolder"
                style="@style/Widget.Nothing.Button.Outlined"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="8dp"
                android:text="@string/result_open_folder" />

            <Button
                android:id="@+id/btnDone"
                style="@style/Widget.Nothing.Button.Text"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="8dp"
                android:text="@string/result_done" />
        </LinearLayout>
    </ScrollView>
</FrameLayout>
