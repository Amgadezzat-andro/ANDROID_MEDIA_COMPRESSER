<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/coordinatorLayout"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    tools:context=".MainActivity">

    <com.google.android.material.appbar.AppBarLayout
        android:id="@+id/appBarLayout"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:theme="@style/Theme.FFShare.AppBarOverlay"
        app:elevation="0dp">

        <androidx.appcompat.widget.Toolbar
            android:id="@+id/toolbar"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:background="?android:attr/colorBackground"
            app:popupTheme="@style/Theme.FFShare.PopupOverlay"
            app:title="@string/app_label"
            app:titleTextAppearance="@style/TextAppearance.Nothing.Title" />

    </com.google.android.material.appbar.AppBarLayout>

    <ScrollView
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:padding="16dp">

            <!-- a batch sent to the background (its screen is hidden from recents), tap to go back to it -->
            <com.google.android.material.card.MaterialCardView
                android:id="@+id/cardOpenBatch"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginBottom="12dp"
                android:clickable="true"
                android:focusable="true"
                android:visibility="gone"
                app:strokeColor="@color/mono_accent"
                app:strokeWidth="2dp">

                <TextView
                    android:id="@+id/lblOpenBatch"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:drawablePadding="8dp"
                    android:padding="16dp"
                    android:textSize="15sp" />
            </com.google.android.material.card.MaterialCardView>

            <!-- Lifetime savings, dot-matrix number on a solid panel -->
            <com.google.android.material.card.MaterialCardView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginBottom="20dp"
                app:cardBackgroundColor="?attr/colorPrimary">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:padding="20dp">

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:alpha="0.7"
                        android:text="@string/stats_title"
                        android:textAppearance="@style/TextAppearance.Nothing.Label"
                        android:textColor="?attr/colorOnPrimary" />

                    <TextView
                        android:id="@+id/lblStatsSaved"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="6dp"
                        android:textAppearance="@style/TextAppearance.FFShare.BigNumber"
                        android:textColor="@color/mono_accent"
                        android:textSize="36sp" />

                    <TextView
                        android:id="@+id/lblStatsDetail"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="4dp"
                        android:alpha="0.8"
                        android:textColor="?attr/colorOnPrimary"
                        android:textSize="14sp" />
                </LinearLayout>
            </com.google.android.material.card.MaterialCardView>

            <!-- Quality presets, one card per preset, swiping picks it -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:gravity="bottom"
                android:orientation="horizontal">

                <TextView
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:text="@string/quality_title"
                    android:textAppearance="@style/TextAppearance.Nothing.Label" />

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="@string/preset_swipe_hint"
                    android:textAppearance="@style/TextAppearance.Nothing.Label"
                    android:textSize="10sp" />
            </LinearLayout>

            <!-- full width so the neighbouring cards peek in from the screen edges -->
            <androidx.viewpager2.widget.ViewPager2
                android:id="@+id/pagerPreset"
                android:layout_width="match_parent"
                android:layout_height="200dp"
                android:layout_marginHorizontal="-16dp"
                android:layout_marginTop="6dp" />

            <LinearLayout
                android:id="@+id/presetDots"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_gravity="center_horizontal"
                android:layout_marginBottom="12dp"
                android:orientation="horizontal" />

            <!-- Photo format, separate from the presets -->
            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/photo_format_title"
                android:textAppearance="@style/TextAppearance.Nothing.Label" />

            <com.google.android.material.button.MaterialButtonToggleGroup
                android:id="@+id/togglePhotoFormat"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="6dp"
                app:selectionRequired="true"
                app:singleSelection="true">

                <Button
                    android:id="@+id/btnFormatWebp"
                    style="@style/Widget.Nothing.Button.Toggle"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:text="@string/photo_format_webp" />

                <Button
                    android:id="@+id/btnFormatOriginal"
                    style="@style/Widget.Nothing.Button.Toggle"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:text="@string/photo_format_original" />
            </com.google.android.material.button.MaterialButtonToggleGroup>

            <TextView
                android:id="@+id/lblPhotoFormatHint"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginBottom="20dp"
                android:alpha="0.7"
                android:textSize="13sp" />

            <!-- Save folder: where compressed copies go, a red dot while one is set (like a recording light) -->
            <com.google.android.material.card.MaterialCardView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginBottom="12dp">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:padding="20dp">

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:gravity="center_vertical"
                        android:orientation="horizontal">

                        <TextView
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_weight="1"
                            android:text="@string/save_to_title"
                            android:textAppearance="@style/TextAppearance.Nothing.Label" />

                        <ImageView
                            android:id="@+id/imgSaveFolderDot"
                            android:layout_width="8dp"
                            android:layout_height="8dp"
                            android:layout_marginEnd="6dp"
                            android:importantForAccessibility="no"
                            android:src="@drawable/save_folder_dot" />

                        <TextView
                            android:id="@+id/lblSaveFolderState"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:textAppearance="@style/TextAppearance.Nothing.Label"
                            android:textSize="10sp" />
                    </LinearLayout>

                    <TextView
                        android:id="@+id/lblSaveFolder"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="10dp"
                        android:ellipsize="middle"
                        android:singleLine="true"
                        android:textAppearance="@style/TextAppearance.Nothing.Display"
                        android:textSize="26sp" />

                    <TextView
                        android:id="@+id/lblSaveFolderPath"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="2dp"
                        android:alpha="0.7"
                        android:textSize="14sp" />

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="12dp"
                        android:gravity="center_vertical"
                        android:orientation="horizontal">

                        <Button
                            android:id="@+id/btnChooseFolder"
                            style="@style/Widget.Nothing.Button.Outlined"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="@string/save_to_choose" />

                        <Button
                            android:id="@+id/btnClearFolder"
                            style="@style/Widget.Nothing.Button.Text"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_marginStart="8dp"
                            android:text="@string/save_to_clear" />
                    </LinearLayout>
                </LinearLayout>
            </com.google.android.material.card.MaterialCardView>

            <!-- credits live in the About dialog and the readme -->
            <TextView
                android:id="@+id/lblVersion"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="4dp"
                android:alpha="0.6"
                android:gravity="center"
                android:text="@string/version"
                android:textAppearance="@style/TextAppearance.Nothing.Label"
                android:textSize="10sp" />
        </LinearLayout>
    </ScrollView>

    <Button
        android:id="@+id/btnSelectFile"
        android:layout_width="match_parent"
        android:layout_height="64dp"
        android:layout_marginHorizontal="16dp"
        android:layout_marginTop="12dp"
        android:text="@string/select_file_button"
        android:textSize="16sp"
        app:cornerRadius="32dp" />

    <!-- the photo picker has a per-pick limit and shows no audio, the files app has neither problem -->
    <Button
        android:id="@+id/btnBrowseFiles"
        android:text="@string/browse_files_button"
        style="@style/Widget.Nothing.Button.Text"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginHorizontal="16dp"
        android:layout_marginBottom="8dp"
        android:fontFamily="@font/space_mono"
        android:letterSpacing="0"
        android:textSize="12sp"
        android:textAllCaps="false"
        android:textColor="?android:attr/textColorSecondary" />

</LinearLayout>
